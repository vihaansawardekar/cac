<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- top bar here -->
    <LinearLayout style="@style/TitleBar">

        <ImageButton style="@style/BackButton" />

        <TextView
            android:id="@+id/titleBar"
            style="@style/TitleText"
            android:text="Scan Your Soil" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- photo card here -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_camera"
                    android:text="Photo of Soil" />

                <TextView
                    style="@style/BodyText"
                    android:text="Get close to the soil or pit wall. Stand so your shadow covers it, and keep plants and rocks out."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/photo_frame">

                    <LinearLayout
                        android:id="@+id/photoHint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Photo"
                            android:src="@drawable/ic_image"
                            app:tint="@color/forest" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Your soil photo shows here"
                            android:textColor="@color/muted" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/photoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/input_normal"
                        android:clipToOutline="true"
                        android:contentDescription="Soil photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:onClick="openCamera"
                        android:text="Take Photo"
                        app:icon="@drawable/ic_camera" />

                    <Button
                        style="@style/GhostButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:onClick="openGallery"
                        android:text="Pick Photo"
                        app:icon="@drawable/ic_image" />
                </LinearLayout>
            </LinearLayout>

            <!-- ai result card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/hero_back"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:textColor="@color/white"
                    app:drawableTint="@color/peach"
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_activity"
                    android:text="AI Result" />

                <com.example.soilmetrics.GaugeView
                    android:id="@+id/resultGauge"
                    android:layout_width="match_parent"
                    android:layout_height="210dp" />

                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/detailText"
                    style="@style/BodyText"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Take or pick a photo to check organic matter." />
            </LinearLayout>

            <!-- save it card -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_pin"
                    android:text="Save to a Field" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="0dp"
                    android:text="Which field?" />

                <Spinner
                    android:id="@+id/fieldSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <TextView
                    style="@style/Label"
                    android:text="Note (optional)" />

                <EditText
                    android:id="@+id/noteBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Example: low spot by the creek"
                    android:inputType="textCapSentences" />
            </LinearLayout>

            <Button
                android:id="@+id/saveButton"
                style="@style/GlowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:onClick="saveSample"
                android:text="Save to Field"
                app:icon="@drawable/ic_check" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
