<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- top bar here -->
    <LinearLayout style="@style/TitleBar">

        <ImageButton style="@style/BackButton" />

        <TextView
            android:id="@+id/titleBar"
            style="@style/TitleText"
            android:text="Soil Test History" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp">

        <!-- add lab test -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_check_circle"
                android:text="Add a Lab Test" />

            <TextView
                style="@style/BodyText"
                android:text="Got a lab soil test? Add it so your trend is more exact."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/labOmBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="OM % (3.2)"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/labDateBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="MM/DD/YYYY"
                    android:inputType="date" />
            </LinearLayout>

            <Button
                style="@style/GhostButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:onClick="addLabTest"
                android:text="Add Lab Test"
                app:icon="@drawable/ic_plus" />
        </LinearLayout>

        <TextView
            android:id="@+id/historyTitle"
            style="@style/CardTitle"
            android:layout_marginBottom="2dp"
            android:drawableStart="@drawable/ic_history"
            android:text="Soil Tests" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="0dp"
            android:text="Press and hold a test to delete it." />

        <ListView
            android:id="@+id/sampleList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />
    </LinearLayout>

</LinearLayout>
